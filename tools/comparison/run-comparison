#!/usr/bin/env bash
# Wrapper script to run comparison_runner with the virtual environment
# Usage: ./run-comparison [args...]
# Example: ./run-comparison --workers 8

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Activate venv if it exists
if [[ -d ".venv" ]]; then
    source .venv/bin/activate
fi

exec python -m comparison_runner "$@"
