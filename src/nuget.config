<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="artifactory" value="https://nethermind.jfrog.io/artifactory/api/nuget/v3/core-nuget-local-prod/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="artifactory">
      <package pattern="Nethermind.Arbitrum.Stylus" />
    </packageSource>
  </packageSourceMapping>
</configuration>
